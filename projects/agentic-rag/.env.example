APP_PROVIDER=demo
APP_TOP_K=3
APP_MAX_UPLOAD_BYTES=1048576
JWT_SECRET=replace-this-in-non-local-environments
JWT_ISSUER=agentic-rag-local
JWT_AUDIENCE=agentic-rag-api
JWT_EXP_MINUTES=60
# 开发辅助端点；部署到非开发环境时设为 false。
APP_ENABLE_DEV_TOKENS=true
# 第 3 章：启动时加载固定企业样例，便于验证权限边界。
APP_SEED_FIXTURES=true

# 第 4、6 章：本地 API 与 Worker 共同使用文件 SQLite 和对象目录。
DATABASE_URL=sqlite+aiosqlite:///./.data/agentic-rag.db
OBJECT_STORE=filesystem
OBJECT_STORE_ROOT=.data/objects
# 部署时改成 PostgreSQL 与 MinIO：
# DATABASE_URL=postgresql+asyncpg://agentic_rag:agentic_rag@localhost:5432/agentic_rag
# OBJECT_STORE=minio
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=agentic-rag

# 切换到 OpenAI-compatible 服务时填写：
# APP_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# EMBEDDING_MODEL=
# CHAT_MODEL=
